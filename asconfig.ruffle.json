{
	"config": "flex",
	"type": "app",
	"compilerOptions": {
		"verbose-stacktraces": true,
		"advanced-telemetry": true,
		"warnings": true,
		"strict": true,
		"source-path": ["src"],
		"output": "bin/ruffle/R3Ruffle.swf",
		"library-path": ["libs/", "libs/assets/"],
		"include-libraries": ["fonts/bin/"],
		"define": [
			{
				"name": "CONFIG::air",
				"value": false
			},
			{
				"name": "CONFIG::debug",
				"value": true
			},
			{
				"name": "CONFIG::release",
				"value": false
			},
			{
				"name": "CONFIG::timeStamp",
				"value": "\"9999-12-31\""
			},
			{
				"name": "R3::HASH_STRING",
				"value": "\"hashstring\""
			},
			{
				"name": "R3::BRAND_NAME_LONG",
				"value": "\"FlashFlashRevolution\""
			},
			{
				"name": "R3::BRAND_NAME_SHORT",
				"value": "\"FFR\""
			},
			{
				"name": "R3::ROOT_URL",
				"value": "\"www.flashflashrevolution.com\""
			},
			{
				"name": "R3::VERSION",
				"value": "\"0.0.0\""
			},
			{
				"name": "R3::VERSION_PREFIX",
				"value": "\"\""
			},
			{
				"name": "R3::VERSION_SUFFIX",
				"value": "\"R\""
			}
		],
		"default-size": {
			"width": 780,
			"height": 480
		},
		"default-frame-rate": 60,
		"default-background-color": "#000000",
		"debug": true,
		"omit-trace-statements": false,
		"swf-version": 26,
		"target-player": "26.0",
		"locale": ["en_US"]
	},
	"files": ["src/Main.as"]
}
